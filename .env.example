# ==============================================================================
# Gemini Local LLM Bridge - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MCP Server Network Settings
# ------------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_SERVER_NAME=Gemini-Local-LLM-Bridge

# ------------------------------------------------------------------------------
# 2. Security & Authentication (Gemini Custom App)
# ------------------------------------------------------------------------------
# Optional secret Bearer token. If set, Gemini must provide this token in Custom App settings.
# Leave empty to allow unauthenticated access during local testing.
AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. LLM Backend Provider Configuration
# ------------------------------------------------------------------------------
# Provider type: "openai_compatible" (default) or "fake" (for testing/ci)
LLM_PROVIDER=openai_compatible

# Local LLM API Base URL (OpenAI-compatible endpoint)
# Examples:
#   Ollama (Host):        http://host.docker.internal:11434/v1   (if running MCP in Docker)
#   Ollama (Local Native): http://127.0.0.1:11434/v1             (if running MCP directly on host)
#   LM Studio:            http://host.docker.internal:1234/v1
#   vLLM / LocalAI:       http://host.docker.internal:8000/v1
#   Remote OpenAI / API:  https://api.openai.com/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1

# API Key for the Local or Remote LLM (optional for local Ollama/LM Studio)
LLM_API_KEY=

# Model Name (as registered in Ollama / LM Studio / backend)
LLM_MODEL=llama3.2

# Request Timeout (in seconds) & Retry Policy
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# System Prompt given to the local model
LLM_SYSTEM_PROMPT=You are a helpful AI assistant serving as a specialized local intelligence node. Analyze the provided context and question carefully, and provide clear, accurate, and concise answers.

# ------------------------------------------------------------------------------
# 4. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
